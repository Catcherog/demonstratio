# Portfolio AI Guide — Provider-Neutral Configuration
#
# The authoritative variables use the PORTFOLIO_AI_* prefix.
# Old variables (ZHIPU_API_KEY, GLM_API_KEY, ZHIPU_BASE_URL) remain as
# backward-compatible aliases but are not the primary source.
#
# Do NOT use NEXT_PUBLIC_ prefixes — these are server-side secrets.
# Do NOT commit real keys to the repository.

# Provider identifier for logging and diagnostics.
PORTFOLIO_AI_PROVIDER=volcengine-ark

# Server-side API key from 火山引擎方舟 Coding Plan.
# This is the authoritative variable. ZHIPU_API_KEY and GLM_API_KEY are compat aliases.
PORTFOLIO_AI_API_KEY=

# Volcengine Ark Coding Plan endpoint (OpenAI-compatible).
# ZHIPU_BASE_URL is a compat alias; if unset, defaults to the Volcengine Ark endpoint below.
PORTFOLIO_AI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# Model ID sent to the provider. Must be verified via a real API call.
# glm-5.2 is the candidate; replace with the verified model ID after probing.
PORTFOLIO_AI_MODEL=glm-5.2

# Optional fallback models, comma separated. Empty means no model fallback.
PORTFOLIO_AI_FALLBACK_MODELS=

# Output, sampling and timeout controls for cost and stability.
PORTFOLIO_AI_MAX_OUTPUT_TOKENS=1600
PORTFOLIO_AI_TEMPERATURE=0.2
PORTFOLIO_AI_TIMEOUT_MS=38000

# Set to 1 to force deterministic evidence-only mode (guided/offline).
PORTFOLIO_AI_DISABLED=0

# Best-effort per-instance requests per minute.
# Add Vercel Firewall rules for stronger global enforcement.
PORTFOLIO_AI_RATE_LIMIT=12

# Included in stream metadata for observability and prompt-change tracking.
PORTFOLIO_AI_PROMPT_VERSION=portfolio-guide-r1

# --- Backward-compatible aliases (do not rely on these for new deployments) ---
# ZHIPU_API_KEY=          # alias for PORTFOLIO_AI_API_KEY
# GLM_API_KEY=            # alias for PORTFOLIO_AI_API_KEY
# ZHIPU_BASE_URL=         # alias for PORTFOLIO_AI_BASE_URL
