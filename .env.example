# Portfolio AI Guide 环境变量示例
# 复制为 .env.local 本地开发；生产/Preview 在 Vercel Dashboard 配置

# 智谱开放平台 API Key（必填，服务端 only，禁止使用 NEXT_PUBLIC_ 前缀）
# 获取地址：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=

# 备用变量名（与 ZHIPU_API_KEY 二选一，ZHIPU_API_KEY 优先）
GLM_API_KEY=

# 智谱 API 基础地址（可选，默认 https://open.bigmodel.cn/api/paas/v4）
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 主模型 ID（可选，默认 glm-5.2）
PORTFOLIO_AI_MODEL=glm-5.2

# 回退模型列表（可选，逗号分隔，最多 3 个）
# PORTFOLIO_AI_FALLBACK_MODELS=glm-4-flash,glm-4

# 关闭 AI 生成，强制使用离线证据回退（可选，设为 1 关闭）
# PORTFOLIO_AI_DISABLED=0

# 每分钟提问上限（可选，默认 12）
# PORTFOLIO_AI_RATE_LIMIT=12

# 模型最大输出 Token（可选，默认 1600，范围 256-4096）
# PORTFOLIO_AI_MAX_OUTPUT_TOKENS=1600

# 模型温度（可选，默认 0.2，范围 0-1）
# PORTFOLIO_AI_TEMPERATURE=0.2

# 模型请求超时毫秒（可选，默认 38000，范围 5000-42000）
# PORTFOLIO_AI_TIMEOUT_MS=38000

# Prompt 版本标记（可选，默认 portfolio-guide-r1）
# PORTFOLIO_AI_PROMPT_VERSION=portfolio-guide-r1
